#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-aether"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-aether"
RUN_DIR="$DATA_DIR/data"
BIN_DIR="$DATA_DIR/bin"
CONFIG_FILE="$CONFIG_DIR/config.env"
PID_FILE="$CONFIG_DIR/aether.pid"
LOG_FILE="$DATA_DIR/aether.log"

mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$RUN_DIR" "$BIN_DIR"

DEFAULT_CUSTOM_BIN=""
DEFAULT_PROTOCOL="masque"
DEFAULT_SCAN="balanced"
DEFAULT_NOIZE="firewall"
DEFAULT_IP="v4"
DEFAULT_SOCKS_PORT=1819
DEFAULT_HTTP_PROXY_PORT=0
DEFAULT_UPSTREAM=""
DEFAULT_MARK="0"
DEFAULT_QUICK_RECONNECT=1
DEFAULT_H2=0
DEFAULT_FRAGMENT=0
DEFAULT_FRAGMENT_SIZE="16-32"
DEFAULT_FRAGMENT_DELAY="2-10"
DEFAULT_NO_QUIC_V2=0
DEFAULT_ECH="off"
DEFAULT_NO_DATA_CHECK=0
DEFAULT_KEEPALIVE=5
DEFAULT_PEER=""
DEFAULT_WIW_OUTER=""
DEFAULT_WIW_INNER=""
DEFAULT_MIM_OUTER=""
DEFAULT_MIM_INNER=""
DEFAULT_DNS=""
DEFAULT_TEAM=""
DEFAULT_ACCESS_TOKEN=""
DEFAULT_GATEWAY=0
DEFAULT_ROUTE_BLOCK=""
DEFAULT_ROUTE_DIRECT=""
DEFAULT_LOG_LEVEL="info"
DEFAULT_EXTRA_ARGS=""
DEFAULT_WG_PEER=""
DEFAULT_H2_PEER=""
DEFAULT_NO_PROFILE_RETRY=0
DEFAULT_VALIDATE_SECS=""
DEFAULT_STARTUP_SECS=""
DEFAULT_RECONNECT_SECS=""
DEFAULT_PERF=""
DEFAULT_TLS_GROUPS=""
DEFAULT_ROUTES_FILE=""
DEFAULT_TOR_BIND=""
DEFAULT_TOR_DIR=""
DEFAULT_TOR_BRIDGES=""
DEFAULT_TOR_BRIDGE=""
DEFAULT_TOR_PT=""
DEFAULT_TOR_PT_DIR=""
DEFAULT_TOR_COUNTRY=""
DEFAULT_ACCESS_ID=""
DEFAULT_ACCESS_SECRET=""
DEFAULT_ACCESS_EMAIL=""

load_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
  fi

  CUSTOM_BIN="${AETHER_CFG_BIN:-$DEFAULT_CUSTOM_BIN}"
  PROTOCOL="${AETHER_CFG_PROTOCOL:-$DEFAULT_PROTOCOL}"
  SCAN="${AETHER_CFG_SCAN:-$DEFAULT_SCAN}"
  NOIZE="${AETHER_CFG_NOIZE:-$DEFAULT_NOIZE}"
  IP_MODE="${AETHER_CFG_IP:-$DEFAULT_IP}"
  SOCKS_PORT="${AETHER_CFG_SOCKS_PORT:-$DEFAULT_SOCKS_PORT}"
  HTTP_PROXY_PORT="${AETHER_CFG_HTTP_PROXY_PORT:-$DEFAULT_HTTP_PROXY_PORT}"
  UPSTREAM="${AETHER_CFG_UPSTREAM:-$DEFAULT_UPSTREAM}"
  MARK="${AETHER_CFG_MARK:-$DEFAULT_MARK}"
  QUICK_RECONNECT="${AETHER_CFG_QUICK_RECONNECT:-$DEFAULT_QUICK_RECONNECT}"
  H2="${AETHER_CFG_H2:-$DEFAULT_H2}"
  FRAGMENT="${AETHER_CFG_FRAGMENT:-$DEFAULT_FRAGMENT}"
  FRAGMENT_SIZE="${AETHER_CFG_FRAGMENT_SIZE:-$DEFAULT_FRAGMENT_SIZE}"
  FRAGMENT_DELAY="${AETHER_CFG_FRAGMENT_DELAY:-$DEFAULT_FRAGMENT_DELAY}"
  NO_QUIC_V2="${AETHER_CFG_NO_QUIC_V2:-$DEFAULT_NO_QUIC_V2}"
  ECH="${AETHER_CFG_ECH:-$DEFAULT_ECH}"
  NO_DATA_CHECK="${AETHER_CFG_NO_DATA_CHECK:-$DEFAULT_NO_DATA_CHECK}"
  KEEPALIVE="${AETHER_CFG_KEEPALIVE:-$DEFAULT_KEEPALIVE}"
  PEER="${AETHER_CFG_PEER:-$DEFAULT_PEER}"
  WIW_OUTER="${AETHER_CFG_WIW_OUTER:-$DEFAULT_WIW_OUTER}"
  WIW_INNER="${AETHER_CFG_WIW_INNER:-$DEFAULT_WIW_INNER}"
  MIM_OUTER="${AETHER_CFG_MIM_OUTER:-$DEFAULT_MIM_OUTER}"
  MIM_INNER="${AETHER_CFG_MIM_INNER:-$DEFAULT_MIM_INNER}"
  DNS="${AETHER_CFG_DNS:-$DEFAULT_DNS}"
  TEAM="${AETHER_CFG_TEAM:-$DEFAULT_TEAM}"
  ACCESS_TOKEN="${AETHER_CFG_ACCESS_TOKEN:-$DEFAULT_ACCESS_TOKEN}"
  GATEWAY="${AETHER_CFG_GATEWAY:-$DEFAULT_GATEWAY}"
  ROUTE_BLOCK="${AETHER_CFG_ROUTE_BLOCK:-$DEFAULT_ROUTE_BLOCK}"
  ROUTE_DIRECT="${AETHER_CFG_ROUTE_DIRECT:-$DEFAULT_ROUTE_DIRECT}"
  LOG_LEVEL="${AETHER_CFG_LOG_LEVEL:-$DEFAULT_LOG_LEVEL}"
  EXTRA_ARGS="${AETHER_CFG_EXTRA_ARGS:-$DEFAULT_EXTRA_ARGS}"
  WG_PEER="${AETHER_CFG_WG_PEER:-$DEFAULT_WG_PEER}"
  H2_PEER="${AETHER_CFG_H2_PEER:-$DEFAULT_H2_PEER}"
  NO_PROFILE_RETRY="${AETHER_CFG_NO_PROFILE_RETRY:-$DEFAULT_NO_PROFILE_RETRY}"
  VALIDATE_SECS="${AETHER_CFG_VALIDATE_SECS:-$DEFAULT_VALIDATE_SECS}"
  STARTUP_SECS="${AETHER_CFG_STARTUP_SECS:-$DEFAULT_STARTUP_SECS}"
  RECONNECT_SECS="${AETHER_CFG_RECONNECT_SECS:-$DEFAULT_RECONNECT_SECS}"
  PERF="${AETHER_CFG_PERF:-$DEFAULT_PERF}"
  TLS_GROUPS="${AETHER_CFG_TLS_GROUPS:-$DEFAULT_TLS_GROUPS}"
  ROUTES_FILE="${AETHER_CFG_ROUTES_FILE:-$DEFAULT_ROUTES_FILE}"
  TOR_BIND="${AETHER_CFG_TOR_BIND:-$DEFAULT_TOR_BIND}"
  TOR_DIR="${AETHER_CFG_TOR_DIR:-$DEFAULT_TOR_DIR}"
  TOR_BRIDGES="${AETHER_CFG_TOR_BRIDGES:-$DEFAULT_TOR_BRIDGES}"
  TOR_BRIDGE="${AETHER_CFG_TOR_BRIDGE:-$DEFAULT_TOR_BRIDGE}"
  TOR_PT="${AETHER_CFG_TOR_PT:-$DEFAULT_TOR_PT}"
  TOR_PT_DIR="${AETHER_CFG_TOR_PT_DIR:-$DEFAULT_TOR_PT_DIR}"
  TOR_COUNTRY="${AETHER_CFG_TOR_COUNTRY:-$DEFAULT_TOR_COUNTRY}"
  ACCESS_ID="${AETHER_CFG_ACCESS_ID:-$DEFAULT_ACCESS_ID}"
  ACCESS_SECRET="${AETHER_CFG_ACCESS_SECRET:-$DEFAULT_ACCESS_SECRET}"
  ACCESS_EMAIL="${AETHER_CFG_ACCESS_EMAIL:-$DEFAULT_ACCESS_EMAIL}"

  # Legacy config files written before %q quoting may carry junk in numeric
  # fields; normalize so downstream arithmetic and JSON stay valid.
  [[ "${SOCKS_PORT:-}" =~ ^[0-9]+$ ]] || SOCKS_PORT="$DEFAULT_SOCKS_PORT"
  [[ "${HTTP_PROXY_PORT:-}" =~ ^[0-9]+$ ]] || HTTP_PROXY_PORT="$DEFAULT_HTTP_PROXY_PORT"
  [[ "${KEEPALIVE:-}" =~ ^[0-9]+$ ]] || KEEPALIVE="$DEFAULT_KEEPALIVE"
}

save_config() {
  # %q shell-quotes every value, so a config.env can always be `source`d
  # safely, no matter what characters a user typed into a panel field.
  {
    printf 'AETHER_CFG_BIN=%q\n' "$CUSTOM_BIN"
    printf 'AETHER_CFG_PROTOCOL=%q\n' "$PROTOCOL"
    printf 'AETHER_CFG_SCAN=%q\n' "$SCAN"
    printf 'AETHER_CFG_NOIZE=%q\n' "$NOIZE"
    printf 'AETHER_CFG_IP=%q\n' "$IP_MODE"
    printf 'AETHER_CFG_SOCKS_PORT=%q\n' "$SOCKS_PORT"
    printf 'AETHER_CFG_HTTP_PROXY_PORT=%q\n' "$HTTP_PROXY_PORT"
    printf 'AETHER_CFG_UPSTREAM=%q\n' "$UPSTREAM"
    printf 'AETHER_CFG_MARK=%q\n' "$MARK"
    printf 'AETHER_CFG_QUICK_RECONNECT=%q\n' "$QUICK_RECONNECT"
    printf 'AETHER_CFG_H2=%q\n' "$H2"
    printf 'AETHER_CFG_FRAGMENT=%q\n' "$FRAGMENT"
    printf 'AETHER_CFG_FRAGMENT_SIZE=%q\n' "$FRAGMENT_SIZE"
    printf 'AETHER_CFG_FRAGMENT_DELAY=%q\n' "$FRAGMENT_DELAY"
    printf 'AETHER_CFG_NO_QUIC_V2=%q\n' "$NO_QUIC_V2"
    printf 'AETHER_CFG_ECH=%q\n' "$ECH"
    printf 'AETHER_CFG_NO_DATA_CHECK=%q\n' "$NO_DATA_CHECK"
    printf 'AETHER_CFG_KEEPALIVE=%q\n' "$KEEPALIVE"
    printf 'AETHER_CFG_PEER=%q\n' "$PEER"
    printf 'AETHER_CFG_WIW_OUTER=%q\n' "$WIW_OUTER"
    printf 'AETHER_CFG_WIW_INNER=%q\n' "$WIW_INNER"
    printf 'AETHER_CFG_MIM_OUTER=%q\n' "$MIM_OUTER"
    printf 'AETHER_CFG_MIM_INNER=%q\n' "$MIM_INNER"
    printf 'AETHER_CFG_DNS=%q\n' "$DNS"
    printf 'AETHER_CFG_TEAM=%q\n' "$TEAM"
    printf 'AETHER_CFG_ACCESS_TOKEN=%q\n' "$ACCESS_TOKEN"
    printf 'AETHER_CFG_GATEWAY=%q\n' "$GATEWAY"
    printf 'AETHER_CFG_ROUTE_BLOCK=%q\n' "$ROUTE_BLOCK"
    printf 'AETHER_CFG_ROUTE_DIRECT=%q\n' "$ROUTE_DIRECT"
    printf 'AETHER_CFG_LOG_LEVEL=%q\n' "$LOG_LEVEL"
    printf 'AETHER_CFG_EXTRA_ARGS=%q\n' "$EXTRA_ARGS"
    printf 'AETHER_CFG_WG_PEER=%q\n' "$WG_PEER"
    printf 'AETHER_CFG_H2_PEER=%q\n' "$H2_PEER"
    printf 'AETHER_CFG_NO_PROFILE_RETRY=%q\n' "$NO_PROFILE_RETRY"
    printf 'AETHER_CFG_VALIDATE_SECS=%q\n' "$VALIDATE_SECS"
    printf 'AETHER_CFG_STARTUP_SECS=%q\n' "$STARTUP_SECS"
    printf 'AETHER_CFG_RECONNECT_SECS=%q\n' "$RECONNECT_SECS"
    printf 'AETHER_CFG_PERF=%q\n' "$PERF"
    printf 'AETHER_CFG_TLS_GROUPS=%q\n' "$TLS_GROUPS"
    printf 'AETHER_CFG_ROUTES_FILE=%q\n' "$ROUTES_FILE"
    printf 'AETHER_CFG_TOR_BIND=%q\n' "$TOR_BIND"
    printf 'AETHER_CFG_TOR_DIR=%q\n' "$TOR_DIR"
    printf 'AETHER_CFG_TOR_BRIDGES=%q\n' "$TOR_BRIDGES"
    printf 'AETHER_CFG_TOR_BRIDGE=%q\n' "$TOR_BRIDGE"
    printf 'AETHER_CFG_TOR_PT=%q\n' "$TOR_PT"
    printf 'AETHER_CFG_TOR_PT_DIR=%q\n' "$TOR_PT_DIR"
    printf 'AETHER_CFG_TOR_COUNTRY=%q\n' "$TOR_COUNTRY"
    printf 'AETHER_CFG_ACCESS_ID=%q\n' "$ACCESS_ID"
    printf 'AETHER_CFG_ACCESS_SECRET=%q\n' "$ACCESS_SECRET"
    printf 'AETHER_CFG_ACCESS_EMAIL=%q\n' "$ACCESS_EMAIL"
  } > "$CONFIG_FILE"

  # Discovery results may be stale after a config change (custom binary,
  # protocol-dependent probing); drop the cache so the next status re-scans.
  rm -f "$RUN_DIR/cores.cache" 2>/dev/null || true
}

load_config

# JSON emission helpers. User-typed values flow into cmd_status, so every
# string must be escaped and every number validated — one raw quote would
# invalidate the whole status document and reset the panel.
json_escape() {
  local s="${1:-}"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

json_str() {
  printf '"%s"' "$(json_escape "${1:-}")"
}

# Emit $1 as a JSON number when it is a plain integer, else fall back to $2.
json_num() {
  if [[ "${1:-}" =~ ^-?[0-9]+$ ]]; then
    printf '%s' "$1"
  else
    printf '%s' "$2"
  fi
}

is_cluvex_aether() {
  local candidate="$1"
  [[ -n "$candidate" && -f "$candidate" && -x "$candidate" ]] || return 1
  if "$candidate" --help 2>&1 | grep -iq "socks5"; then
    return 0
  fi
  return 1
}

has_cap_net_admin() {
  local binary="$1"
  [[ -x "$binary" ]] || return 1
  if command -v getcap &>/dev/null; then
    local caps
    caps=$(getcap "$binary" 2>/dev/null || true)
    if [[ "$caps" == *"cap_net_admin"* ]]; then
      return 0
    fi
  fi
  if [[ "$(id -u)" -eq 0 ]]; then
    return 0
  fi
  return 1
}

get_binary_version() {
  local binary="$1"
  [[ -x "$binary" ]] || return 1
  local ver
  ver=$("$binary" --version 2>/dev/null | head -n1 || true)
  if [[ -n "$ver" ]]; then
    echo "$ver"
  else
    echo "Unknown version"
  fi
}

find_all_cores() {
  # Discovery probes every candidate with `--help`; the status poll would
  # repeat that every few seconds. Cache results for a short TTL and drop
  # the cache whenever the config changes (see save_config) or a core is
  # installed/removed.
  local cache="$RUN_DIR/cores.cache"
  if [[ -f "$cache" ]]; then
    local mtime now
    mtime=$(stat -c%Y "$cache" 2>/dev/null || echo 0)
    now=$(date +%s)
    if (( now - mtime < 30 )); then
      cat "$cache"
      return 0
    fi
  fi

  local result
  result=$(discover_all_cores)
  printf '%s\n' "$result" > "$cache"
  printf '%s\n' "$result"
}

discover_all_cores() {
  local candidates=(
    "$CUSTOM_BIN"
    "$BIN_DIR/aether"
    "$HOME/Downloads/Aether/aether"
    "$PLUGIN_ROOT/bin/aether"
    "$HOME/.local/bin/aether"
    "/usr/local/bin/aether"
    "/opt/aether/aether"
  )

  local seen=""
  for cand in "${candidates[@]}"; do
    [[ -n "$cand" ]] || continue
    if [[ " $seen " != *" $cand "* ]]; then
      seen="$seen $cand"
      if is_cluvex_aether "$cand"; then
        echo "$cand"
      fi
    fi
  done

  while IFS= read -r cand; do
    [[ -n "$cand" ]] || continue
    if [[ " $seen " != *" $cand "* ]]; then
      seen="$seen $cand"
      if is_cluvex_aether "$cand"; then
        echo "$cand"
      fi
    fi
  done < <(which -a aether 2>/dev/null || true)
}

detect_aether_bin() {
  if [[ -n "$CUSTOM_BIN" ]] && is_cluvex_aether "$CUSTOM_BIN"; then
    echo "$CUSTOM_BIN"
    return 0
  fi

  local first_found
  first_found=$(find_all_cores | head -n1 || true)
  if [[ -n "$first_found" ]]; then
    echo "$first_found"
    return 0
  fi

  return 1
}

has_systemd_service() {
  systemctl --user list-unit-files aether.service &>/dev/null
}

# True when $1 is a live PID whose cmdline matches the recorded core binary
# (or, for pid files written before the binary was recorded, an aether
# transport). Guards against killing an unrelated process whose PID was
# recycled after a crash.
is_aether_pid() {
  local pid="$1" rec_bin="${2:-}"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ -r "/proc/$pid/cmdline" ]] || return 1
  local cmdline
  cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
  if [[ -n "$rec_bin" ]]; then
    [[ "$cmdline" == *"$rec_bin"* ]] && return 0
  fi
  [[ "$cmdline" == *"aether"* && "$cmdline" =~ (--masque|--wg|--gool|--mim|--tor) ]]
}

get_running_pid() {
  if [[ -f "$PID_FILE" ]]; then
    local pid rec_bin
    pid=$(head -n1 "$PID_FILE" 2>/dev/null || true)
    rec_bin=$(sed -n '2p' "$PID_FILE" 2>/dev/null || true)
    if is_aether_pid "$pid" "$rec_bin"; then
      echo "$pid"
      return 0
    fi
  fi

  local pids
  pids=$(pgrep -f "aether.*(--masque|--wg|--gool|--mim|--tor)" 2>/dev/null || true)
  if [[ -n "$pids" ]]; then
    local p
    while IFS= read -r p; do
      if is_aether_pid "$p"; then
        echo "$p"
        return 0
      fi
    done <<< "$pids"
  fi

  return 1
}

is_running() {
  if has_systemd_service && systemctl --user is-active --quiet aether 2>/dev/null; then
    return 0
  fi
  get_running_pid >/dev/null 2>&1
}

probe_trace() {
  local port="${1:-$SOCKS_PORT}"
  local start_time end_time elapsed_ms
  start_time=$(date +%s%N)
  local trace
  trace=$(curl -s --connect-timeout 2 -m 3 -x "socks5h://127.0.0.1:${port}" https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null || true)
  end_time=$(date +%s%N)

  if [[ -z "$trace" || "$trace" != *"warp="* ]]; then
    return 1
  fi

  elapsed_ms=$(( (end_time - start_time) / 1000000 ))
  echo "$trace"
  echo "latency_ms=$elapsed_ms"
}

build_args() {
  local bin="$1"
  local args=()

  case "$PROTOCOL" in
    masque)
      args+=("--masque")
      if [[ "$H2" == "1" ]]; then
        args+=("--h2")
        if [[ -n "$H2_PEER" ]]; then
          args+=("--h2-peer" "$H2_PEER")
        fi
        if [[ "$FRAGMENT" == "1" ]]; then
          args+=("--fragment")
          if [[ -n "$FRAGMENT_SIZE" && "$FRAGMENT_SIZE" != "$DEFAULT_FRAGMENT_SIZE" ]]; then
            args+=("--fragment-size" "$FRAGMENT_SIZE")
          fi
          if [[ -n "$FRAGMENT_DELAY" && "$FRAGMENT_DELAY" != "$DEFAULT_FRAGMENT_DELAY" ]]; then
            args+=("--fragment-delay" "$FRAGMENT_DELAY")
          fi
        fi
      else
        if [[ "$NO_QUIC_V2" == "1" ]]; then
          args+=("--no-quic-v2")
        fi
      fi
      if [[ -n "$ECH" && "$ECH" != "off" ]]; then
        args+=("--ech" "$ECH")
      fi
      if [[ -n "$VALIDATE_SECS" ]]; then
        args+=("--validate-secs" "$VALIDATE_SECS")
      fi
      if [[ -n "$STARTUP_SECS" ]]; then
        args+=("--startup-secs" "$STARTUP_SECS")
      fi
      if [[ -n "$RECONNECT_SECS" ]]; then
        args+=("--reconnect-secs" "$RECONNECT_SECS")
      fi
      ;;
    wg)
      args+=("--wg")
      if [[ -n "$KEEPALIVE" && "$KEEPALIVE" != "$DEFAULT_KEEPALIVE" ]]; then
        args+=("--keepalive" "$KEEPALIVE")
      fi
      if [[ -n "$WG_PEER" ]]; then
        args+=("--wg-peer" "$WG_PEER")
      fi
      if [[ "$NO_PROFILE_RETRY" == "1" ]]; then
        args+=("--no-profile-retry")
      fi
      ;;
    gool)
      args+=("--gool")
      if [[ -n "$WIW_OUTER" && -n "$WIW_INNER" ]]; then
        args+=("--wiw-outer" "$WIW_OUTER" "--wiw-inner" "$WIW_INNER")
      elif [[ -n "$WIW_OUTER" ]]; then
        args+=("--wiw-outer" "$WIW_OUTER")
      elif [[ -n "$WIW_INNER" ]]; then
        args+=("--wiw-inner" "$WIW_INNER")
      fi
      ;;
    mim)
      args+=("--mim")
      if [[ "$H2" == "1" ]]; then
        args+=("--h2")
      fi
      if [[ -n "$MIM_OUTER" && -n "$MIM_INNER" ]]; then
        args+=("--mim-outer" "$MIM_OUTER" "--mim-inner" "$MIM_INNER")
      elif [[ -n "$MIM_OUTER" ]]; then
        args+=("--mim-outer" "$MIM_OUTER")
      elif [[ -n "$MIM_INNER" ]]; then
        args+=("--mim-inner" "$MIM_INNER")
      fi
      ;;
    tor)
      args+=("--masque" "--tor")
      ;;
    tor-reverse)
      args+=("--tor-reverse")
      ;;
    tor-only)
      args+=("--tor-only")
      ;;
    *)
      args+=("--masque")
      ;;
  esac

  if [[ -n "$SCAN" ]]; then
    args+=("--scan" "$SCAN")
  fi

  if [[ -n "$NOIZE" ]]; then
    args+=("--noize" "$NOIZE")
  fi

  case "$IP_MODE" in
    v4) args+=("-4") ;;
    v6) args+=("-6") ;;
    dual) args+=("--dual") ;;
  esac

  if [[ -n "$PEER" ]]; then
    args+=("--peer" "$PEER")
  fi

  args+=("--bind" "127.0.0.1:${SOCKS_PORT}")

  if [[ "$HTTP_PROXY_PORT" != "0" && -n "$HTTP_PROXY_PORT" ]]; then
    args+=("--http-proxy" "127.0.0.1:${HTTP_PROXY_PORT}")
  fi

  if [[ -n "$UPSTREAM" ]]; then
    args+=("--upstream" "$UPSTREAM")
  fi

  if [[ "$NO_DATA_CHECK" == "1" ]]; then
    args+=("--no-data-check")
  fi

  if [[ -n "$DNS" ]]; then
    args+=("--dns" "$DNS")
  fi

  if [[ -n "$TEAM" ]]; then
    args+=("--team" "$TEAM")
  fi
  if [[ -n "$ACCESS_TOKEN" ]]; then
    args+=("--access-token" "$ACCESS_TOKEN")
  fi
  if [[ -n "$ACCESS_ID" ]]; then
    args+=("--access-id" "$ACCESS_ID")
  fi
  if [[ -n "$ACCESS_SECRET" ]]; then
    args+=("--access-secret" "$ACCESS_SECRET")
  fi
  if [[ -n "$ACCESS_EMAIL" ]]; then
    args+=("--access-email" "$ACCESS_EMAIL")
  fi
  if [[ "$GATEWAY" == "1" ]]; then
    args+=("--gateway")
  fi

  if [[ -n "$ROUTE_BLOCK" ]]; then
    args+=("--route-block" "$ROUTE_BLOCK")
  fi
  if [[ -n "$ROUTE_DIRECT" ]]; then
    args+=("--route-direct" "$ROUTE_DIRECT")
  fi
  if [[ -n "$ROUTES_FILE" ]]; then
    args+=("--routes" "$ROUTES_FILE")
  fi

  # Tor extras only make sense for the tor transports; a core built without
  # the tor feature would reject these flags outright.
  if [[ "$PROTOCOL" == tor* ]]; then
    if [[ -n "$TOR_BIND" ]]; then
      args+=("--tor-bind" "$TOR_BIND")
    fi
    if [[ -n "$TOR_DIR" ]]; then
      args+=("--tor-dir" "$TOR_DIR")
    fi
    if [[ "$TOR_BRIDGES" == "on" ]]; then
      args+=("--tor-bridges")
    elif [[ "$TOR_BRIDGES" == "off" ]]; then
      args+=("--no-tor-bridges")
    fi
    if [[ -n "$TOR_BRIDGE" ]]; then
      args+=("--tor-bridge" "$TOR_BRIDGE")
    fi
    if [[ -n "$TOR_PT" ]]; then
      args+=("--tor-pt" "$TOR_PT")
    fi
    if [[ -n "$TOR_PT_DIR" ]]; then
      args+=("--tor-pt-dir" "$TOR_PT_DIR")
    fi
  fi

  if [[ -n "$TLS_GROUPS" ]]; then
    args+=("--tls-groups" "$TLS_GROUPS")
  fi
  if [[ -n "$PERF" ]]; then
    args+=("--perf" "$PERF")
  fi

  if [[ "$MARK" == "1" || "$MARK" == "0xff" ]]; then
    if has_cap_net_admin "$bin"; then
      args+=("--mark" "0xff")
    else
      echo "[$(date -Iseconds)] [plugin] --mark requested but lacking CAP_NET_ADMIN; omitting" >> "$LOG_FILE"
    fi
  fi

  if [[ "$QUICK_RECONNECT" == "1" ]]; then
    args+=("--quick-reconnect")
  else
    args+=("--no-quick-reconnect")
  fi

  if [[ -n "$LOG_LEVEL" ]]; then
    args+=("--log-level" "$LOG_LEVEL")
  fi

  if [[ -n "$EXTRA_ARGS" ]]; then
    # shellcheck disable=SC2206
    local extra=($EXTRA_ARGS)
    args+=("${extra[@]}")
  fi

  printf '%s\n' "${args[@]}"
}

rotate_logs_if_needed() {
  if [[ -f "$LOG_FILE" ]]; then
    local size
    size=$(stat -c%s "$LOG_FILE" 2>/dev/null || echo 0)
    if (( size > 2097152 )); then
      mv "$LOG_FILE" "${LOG_FILE}.old"
    fi
  fi
}

cmd_status() {
  local bin=""
  bin=$(detect_aether_bin || true)
  local installed="false"
  local bin_version=""
  local has_cap="false"

  if [[ -n "$bin" ]]; then
    installed="true"
    bin_version=$(get_binary_version "$bin")
    if has_cap_net_admin "$bin"; then
      has_cap="true"
    fi
  fi

  local running="false"
  local pid=""
  if is_running; then
    running="true"
    pid=$(get_running_pid || true)
  fi

  local connected="false"
  local ip=""
  local colo=""
  local loc=""
  local warp=""
  local latency=0

  if [[ "$running" == "true" ]]; then
    local trace_output
    if trace_output=$(probe_trace "$SOCKS_PORT"); then
      connected="true"
      ip=$(echo "$trace_output" | awk -F= '$1=="ip"{print $2}')
      colo=$(echo "$trace_output" | awk -F= '$1=="colo"{print $2}')
      loc=$(echo "$trace_output" | awk -F= '$1=="loc"{print $2}')
      warp=$(echo "$trace_output" | awk -F= '$1=="warp"{print $2}')
      latency=$(echo "$trace_output" | awk -F= '$1=="latency_ms"{print $2}')
    fi
  fi

  local cores_json="[]"
  local core_list=()
  while IFS= read -r c; do
    [[ -n "$c" ]] || continue
    core_list+=("\"$(json_escape "$c")\"")
  done < <(find_all_cores)

  if (( ${#core_list[@]} > 0 )); then
    cores_json="[ $(IFS=,; echo "${core_list[*]}") ]"
  fi

  cat <<EOF
{
  "installed": $installed,
  "binary": $(json_str "$bin"),
  "binary_version": $(json_str "$bin_version"),
  "has_cap_net_admin": $has_cap,
  "running": $running,
  "pid": $(json_str "${pid:-}"),
  "connected": $connected,
  "ip": $(json_str "${ip:-}"),
  "colo": $(json_str "${colo:-}"),
  "loc": $(json_str "${loc:-}"),
  "warp": $(json_str "${warp:-}"),
  "latency_ms": $(json_num "${latency:-0}" 0),
  "proxy_port": $(json_num "$SOCKS_PORT" 1819),
  "http_proxy_port": $(json_num "$HTTP_PROXY_PORT" 0),
  "protocol": $(json_str "$PROTOCOL"),
  "scan": $(json_str "$SCAN"),
  "noize": $(json_str "$NOIZE"),
  "ip_mode": $(json_str "$IP_MODE"),
  "h2": $( [[ "$H2" == "1" ]] && echo "true" || echo "false" ),
  "fragment": $( [[ "$FRAGMENT" == "1" ]] && echo "true" || echo "false" ),
  "quick_reconnect": $( [[ "$QUICK_RECONNECT" == "1" ]] && echo "true" || echo "false" ),
  "mark_enabled": $( [[ "$MARK" == "1" || "$MARK" == "0xff" ]] && echo "true" || echo "false" ),
  "no_quic_v2": $( [[ "$NO_QUIC_V2" == "1" ]] && echo "true" || echo "false" ),
  "ech": $(json_str "$ECH"),
  "no_data_check": $( [[ "$NO_DATA_CHECK" == "1" ]] && echo "true" || echo "false" ),
  "keepalive": $(json_num "$KEEPALIVE" 5),
  "fragment_size": $(json_str "$FRAGMENT_SIZE"),
  "fragment_delay": $(json_str "$FRAGMENT_DELAY"),
  "extra_args": $(json_str "$EXTRA_ARGS"),
  "peer": $(json_str "$PEER"),
  "wiw_outer": $(json_str "$WIW_OUTER"),
  "wiw_inner": $(json_str "$WIW_INNER"),
  "mim_outer": $(json_str "$MIM_OUTER"),
  "mim_inner": $(json_str "$MIM_INNER"),
  "dns": $(json_str "$DNS"),
  "team": $(json_str "$TEAM"),
  "gateway": $( [[ "$GATEWAY" == "1" ]] && echo "true" || echo "false" ),
  "upstream": $(json_str "$UPSTREAM"),
  "route_direct": $(json_str "$ROUTE_DIRECT"),
  "route_block": $(json_str "$ROUTE_BLOCK"),
  "log_level": $(json_str "$LOG_LEVEL"),
  "wg_peer": $(json_str "$WG_PEER"),
  "h2_peer": $(json_str "$H2_PEER"),
  "no_profile_retry": $( [[ "$NO_PROFILE_RETRY" == "1" ]] && echo "true" || echo "false" ),
  "validate_secs": $(json_str "$VALIDATE_SECS"),
  "startup_secs": $(json_str "$STARTUP_SECS"),
  "reconnect_secs": $(json_str "$RECONNECT_SECS"),
  "perf": $(json_str "$PERF"),
  "tls_groups": $(json_str "$TLS_GROUPS"),
  "routes_file": $(json_str "$ROUTES_FILE"),
  "tor_bind": $(json_str "$TOR_BIND"),
  "tor_dir": $(json_str "$TOR_DIR"),
  "tor_bridges": $(json_str "$TOR_BRIDGES"),
  "tor_bridge": $(json_str "$TOR_BRIDGE"),
  "tor_pt": $(json_str "$TOR_PT"),
  "tor_pt_dir": $(json_str "$TOR_PT_DIR"),
  "tor_country": $(json_str "$TOR_COUNTRY"),
  "access_id": $(json_str "$ACCESS_ID"),
  "access_secret": $(json_str "$ACCESS_SECRET"),
  "access_email": $(json_str "$ACCESS_EMAIL"),
  "discovered_cores": $cores_json
}
EOF
}

cmd_start() {
  if is_running; then
    echo "Aether is already running."
    return 0
  fi

  local bin
  bin=$(detect_aether_bin) || {
    echo "Aether core not found. Download core or specify custom binary path." >&2
    return 1
  }

  rotate_logs_if_needed

  mapfile -t ARGS < <(build_args "$bin")

  echo "[$(date -Iseconds)] [plugin] Launching $bin ${ARGS[*]}" >> "$LOG_FILE"

  # AETHER_TOR_COUNTRY is env-only upstream (no flag)
  if [[ -n "$TOR_COUNTRY" ]]; then
    export AETHER_TOR_COUNTRY="$TOR_COUNTRY"
  fi

  cd "$RUN_DIR"
  setsid "$bin" "${ARGS[@]}" </dev/null >>"$LOG_FILE" 2>&1 &
  local pid=$!
  # Line 1: PID. Line 2: core binary — lets get_running_pid confirm the
  # process identity before signaling (PID reuse protection).
  printf '%s\n%s\n' "$pid" "$bin" > "$PID_FILE"
  disown "$pid"

  sleep 0.8
  if ! kill -0 "$pid" 2>/dev/null; then
    local err
    err=$(tail -n 6 "$LOG_FILE" 2>/dev/null | grep -iE "error|denied|failed|cannot" | head -n1 || true)
    if [[ -z "$err" ]]; then
      err=$(tail -n 2 "$LOG_FILE" 2>/dev/null | head -n1 || true)
    fi
    rm -f "$PID_FILE"
    echo "Failed to start: ${err:-process terminated immediately}" >&2
    return 1
  fi

  echo "Started Aether (PID $pid)."
}

cmd_stop() {
  # When the systemd unit owns the tunnel, stop it through systemd —
  # signaling the process directly would count as a failure and
  # Restart=on-failure would respawn it 3s later.
  if has_systemd_service && systemctl --user is-active --quiet aether 2>/dev/null; then
    systemctl --user stop aether
    rm -f "$PID_FILE"
    echo "Stopped Aether."
    return 0
  fi

  local pid
  pid=$(get_running_pid || true)

  if [[ -n "$pid" ]]; then
    kill -INT "$pid" 2>/dev/null || true
    for _ in {1..15}; do
      if ! kill -0 "$pid" 2>/dev/null; then
        break
      fi
      sleep 0.05
    done

    if kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
      sleep 0.2
    fi

    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi

  rm -f "$PID_FILE"

  # Intentional: also reap stray aether processes started outside the plugin
  # (e.g. leftover from a manual terminal run) so they don't fight the panel.
  local rogue
  rogue=$(pgrep -f "aether.*(--masque|--wg|--gool|--mim|--tor)" 2>/dev/null || true)
  if [[ -n "$rogue" ]]; then
    kill -KILL "$rogue" 2>/dev/null || true
  fi

  echo "Stopped Aether."
}

cmd_restart() {
  cmd_stop
  sleep 0.2
  cmd_start
}

cmd_toggle() {
  if is_running; then
    cmd_stop
  else
    cmd_start
  fi
}

# Run in the foreground (no setsid/disown) for systemd Type=simple
cmd_foreground() {
  local bin
  bin=$(detect_aether_bin) || {
    echo "Aether core not found. Download core or specify custom binary path." >&2
    return 1
  }

  rotate_logs_if_needed

  mapfile -t ARGS < <(build_args "$bin")

  echo "[$(date -Iseconds)] [plugin] Executing $bin ${ARGS[*]}" >> "$LOG_FILE"

  if [[ -n "$TOR_COUNTRY" ]]; then
    export AETHER_TOR_COUNTRY="$TOR_COUNTRY"
  fi

  cd "$RUN_DIR"
  exec "$bin" "${ARGS[@]}"
}

cmd_install() {
  local arch
  arch=$(uname -m)
  local release_file=""

  case "$arch" in
    x86_64)  release_file="aether-linux-x86_64.tar.gz" ;;
    aarch64|arm64) release_file="aether-linux-arm64.tar.gz" ;;
    armv7l)  release_file="aether-linux-armv7.tar.gz" ;;
    *)
      echo "Unsupported architecture: $arch" >&2
      return 1
      ;;
  esac

  mkdir -p "$BIN_DIR"
  local url="https://github.com/CluvexStudio/Aether/releases/latest/download/${release_file}"
  # mktemp: a predictable /tmp path would let another user pre-create a
  # symlink and make curl clobber a victim-owned file.
  local tmp_file
  tmp_file=$(mktemp /tmp/aether-download.XXXXXX)

  echo "Downloading Aether ($arch) from $url..."

  local dl_ok=0
  if curl -fsSL --connect-timeout 5 -m 45 "$url" -o "$tmp_file"; then
    dl_ok=1
  elif is_running && curl -fsSL --connect-timeout 5 -m 45 -x "socks5h://127.0.0.1:${SOCKS_PORT}" "$url" -o "$tmp_file"; then
    echo "Downloaded via proxy fallback."
    dl_ok=1
  fi

  if [[ "$dl_ok" -ne 1 ]]; then
    rm -f "$tmp_file"
    echo "Download failed. Check your internet connection." >&2
    return 1
  fi

  echo "Extracting binary..."
  tar -xzf "$tmp_file" -C "$BIN_DIR"
  chmod +x "$BIN_DIR/aether"
  rm -f "$tmp_file"

  CUSTOM_BIN="$BIN_DIR/aether"
  save_config

  echo "Installed Aether to $BIN_DIR/aether"

  if is_running; then
    echo "Restarting tunnel with the new core…"
    cmd_restart
  fi
}

cmd_set_config() {
  local key="${1:-}"
  local val="${2:-}"

  [[ -n "$key" ]] || { echo "Key required" >&2; return 1; }

  case "$key" in
    bin)
      if [[ -n "$val" ]] && ! is_cluvex_aether "$val"; then
        echo "Error: '$val' is not a valid executable Aether binary." >&2
        return 1
      fi
      CUSTOM_BIN="$val"
      ;;
    protocol) PROTOCOL="$val" ;;
    scan) SCAN="$val" ;;
    noize) NOIZE="$val" ;;
    ip) IP_MODE="$val" ;;
    socks_port)
      [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 1024 && val <= 65535 )) || { echo "Error: socks_port must be an integer between 1024 and 65535." >&2; return 1; }
      SOCKS_PORT="$val" ;;
    http_proxy_port)
      [[ "$val" =~ ^[0-9]+$ ]] && (( val <= 65535 )) || { echo "Error: http_proxy_port must be an integer between 0 and 65535." >&2; return 1; }
      HTTP_PROXY_PORT="$val" ;;
    upstream) UPSTREAM="$val" ;;
    mark) MARK="$val" ;;
    quick_reconnect) QUICK_RECONNECT="$val" ;;
    h2) H2="$val" ;;
    fragment) FRAGMENT="$val" ;;
    fragment_size) FRAGMENT_SIZE="$val" ;;
    fragment_delay) FRAGMENT_DELAY="$val" ;;
    no_quic_v2) NO_QUIC_V2="$val" ;;
    ech) ECH="$val" ;;
    no_data_check) NO_DATA_CHECK="$val" ;;
    keepalive)
      [[ "$val" =~ ^[0-9]+$ ]] || { echo "Error: keepalive must be a non-negative integer." >&2; return 1; }
      KEEPALIVE="$val" ;;
    peer) PEER="$val" ;;
    wiw_outer) WIW_OUTER="$val" ;;
    wiw_inner) WIW_INNER="$val" ;;
    mim_outer) MIM_OUTER="$val" ;;
    mim_inner) MIM_INNER="$val" ;;
    dns) DNS="$val" ;;
    team) TEAM="$val" ;;
    access_token) ACCESS_TOKEN="$val" ;;
    gateway) GATEWAY="$val" ;;
    route_block) ROUTE_BLOCK="$val" ;;
    route_direct) ROUTE_DIRECT="$val" ;;
    log_level) LOG_LEVEL="$val" ;;
    extra_args) EXTRA_ARGS="$val" ;;
    wg_peer) WG_PEER="$val" ;;
    h2_peer) H2_PEER="$val" ;;
    no_profile_retry) NO_PROFILE_RETRY="$val" ;;
    validate_secs) VALIDATE_SECS="$val" ;;
    startup_secs) STARTUP_SECS="$val" ;;
    reconnect_secs) RECONNECT_SECS="$val" ;;
    perf) PERF="$val" ;;
    tls_groups) TLS_GROUPS="$val" ;;
    routes_file) ROUTES_FILE="$val" ;;
    tor_bind) TOR_BIND="$val" ;;
    tor_dir) TOR_DIR="$val" ;;
    tor_bridges) TOR_BRIDGES="$val" ;;
    tor_bridge) TOR_BRIDGE="$val" ;;
    tor_pt) TOR_PT="$val" ;;
    tor_pt_dir) TOR_PT_DIR="$val" ;;
    tor_country) TOR_COUNTRY="$val" ;;
    access_id) ACCESS_ID="$val" ;;
    access_secret) ACCESS_SECRET="$val" ;;
    access_email) ACCESS_EMAIL="$val" ;;
    *)
      echo "Unknown config key: $key" >&2
      return 1
      ;;
  esac

  save_config

  if is_running; then
    cmd_restart
  else
    echo "Updated $key=$val"
  fi
}

cmd_set_protocol() {
  local proto="${1:-masque}"
  local h2="${2:-0}"

  case "$proto" in
    masque|wg|gool|mim) ;;
    *) echo "Unknown protocol: $proto" >&2; return 1 ;;
  esac

  PROTOCOL="$proto"
  H2="$h2"
  save_config

  if is_running; then
    cmd_restart
  else
    echo "Protocol set to $proto (h2=$h2)"
  fi
}

cmd_logs() {
  local lines="${1:-60}"
  if [[ -f "$LOG_FILE" ]]; then
    tail -n "$lines" "$LOG_FILE"
  else
    echo "No log entries yet."
  fi
}

cmd_clear_logs() {
  if [[ -f "$LOG_FILE" ]]; then
    truncate -s 0 "$LOG_FILE"
  fi
  echo "Logs cleared."
}

cmd_clear_cache() {
  rm -f "$RUN_DIR"/*lastconn* "$RUN_DIR"/*secondary*
  echo "Connection cache cleared."
}

cmd_remove_core() {
  local target="${1:-}"
  [[ -n "$target" ]] || { echo "Path required" >&2; return 1; }

  target="$(readlink -f "$target" 2>/dev/null || echo "$target")"

  if ! is_cluvex_aether "$target"; then
    echo "Error: '$target' is not a valid Aether binary." >&2
    return 1
  fi

  local active
  active=$(detect_aether_bin || true)
  if [[ -n "$active" && "$target" == "$active" ]]; then
    echo "Error: cannot remove the active core. Switch to another core first." >&2
    return 1
  fi

  if [[ "$target" == "$BIN_DIR/aether" ]]; then
    rm -rf "$BIN_DIR"
    echo "Removed managed core directory $BIN_DIR"
  else
    rm -f "$target"
    echo "Removed $target"
  fi

  rm -f "$RUN_DIR/cores.cache" 2>/dev/null || true
}

case "${1:-status}" in
  status) cmd_status ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  toggle) cmd_toggle ;;
  foreground) cmd_foreground ;;
  install) cmd_install ;;
  set) shift; cmd_set_config "$@" ;;
  set-protocol) shift; cmd_set_protocol "$@" ;;
  cores|list-cores) find_all_cores ;;
  logs) cmd_logs "${2:-60}" ;;
  clear-logs) cmd_clear_logs ;;
  clear-cache) cmd_clear_cache ;;
  remove-core) shift; cmd_remove_core "${1:-}" ;;
  probe) probe_trace "$SOCKS_PORT" ;;
  *)
    echo "Usage: aether-ctl {status|start|stop|restart|toggle|install|set <key> <val>|cores|remove-core <path>|logs [N]|clear-logs|clear-cache|probe}"
    exit 1
    ;;
esac
