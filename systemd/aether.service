[Unit]
Description=Aether censorship circumvention tunnel (omarchy-aether plugin)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.config/omarchy/plugins/cluvex.aether/bin/aether-ctl foreground
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
